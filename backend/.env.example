DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Min 32 characters, e.g. generate with: openssl rand -base64 48
JWT_SECRET=
# Optional, defaults to 60
# JWT_EXPIRATION_MINUTES=60
# Frontend origin(s) allowed to make credentialed CORS requests (comma-separated)
# FRONTEND_ORIGIN=http://localhost:5173
# Auth cookie attributes. Use COOKIE_SAME_SITE=None (requires COOKIE_SECURE=true) only if the
# frontend and backend are on different *sites*.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=Lax
